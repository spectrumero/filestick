/*
 * CPU test suite - the list of tests, in the order they're run.
 *
 * TEST(function, name shown, group)
 * The function is test_<function>, in one of the .S files.
 */

// RV32I
TEST(regfile,     "regfile",     GRP_I)
TEST(lui,         "lui",         GRP_I)
TEST(auipc,       "auipc",       GRP_I)
TEST(jal,         "jal",         GRP_I)
TEST(jalr,        "jalr",        GRP_I)
TEST(beq,         "beq",         GRP_I)
TEST(bne,         "bne",         GRP_I)
TEST(blt,         "blt",         GRP_I)
TEST(bge,         "bge",         GRP_I)
TEST(bltu,        "bltu",        GRP_I)
TEST(bgeu,        "bgeu",        GRP_I)
TEST(branch_far,  "branch_far",  GRP_I)
TEST(lb,          "lb",          GRP_I)
TEST(lh,          "lh",          GRP_I)
TEST(lw,          "lw",          GRP_I)
TEST(lbu,         "lbu",         GRP_I)
TEST(lhu,         "lhu",         GRP_I)
TEST(sb,          "sb",          GRP_I)
TEST(sh,          "sh",          GRP_I)
TEST(sw,          "sw",          GRP_I)
TEST(addi,        "addi",        GRP_I)
TEST(slti,        "slti",        GRP_I)
TEST(sltiu,       "sltiu",       GRP_I)
TEST(xori,        "xori",        GRP_I)
TEST(ori,         "ori",         GRP_I)
TEST(andi,        "andi",        GRP_I)
TEST(slli,        "slli",        GRP_I)
TEST(srli,        "srli",        GRP_I)
TEST(srai,        "srai",        GRP_I)
TEST(add,         "add",         GRP_I)
TEST(sub,         "sub",         GRP_I)
TEST(sll,         "sll",         GRP_I)
TEST(slt,         "slt",         GRP_I)
TEST(sltu,        "sltu",        GRP_I)
TEST(xor,         "xor",         GRP_I)
TEST(srl,         "srl",         GRP_I)
TEST(sra,         "sra",         GRP_I)
TEST(or,          "or",          GRP_I)
TEST(and,         "and",         GRP_I)

// FENCE: the last RV32I test, and only run if asked for, since a core that
// doesn't implement it will take an illegal instruction trap.
TEST(fence,       "fence",       GRP_FENCE)

// RV32M
TEST(mul,         "mul",         GRP_M)
TEST(mulh,        "mulh",        GRP_M)
TEST(mulhsu,      "mulhsu",      GRP_M)
TEST(mulhu,       "mulhu",       GRP_M)
TEST(div,         "div",         GRP_M)
TEST(divu,        "divu",        GRP_M)
TEST(rem,         "rem",         GRP_M)
TEST(remu,        "remu",        GRP_M)

// RV32C
TEST(c_addi4spn,  "c.addi4spn",  GRP_C)
TEST(c_lw,        "c.lw",        GRP_C)
TEST(c_sw,        "c.sw",        GRP_C)
